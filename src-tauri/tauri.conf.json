{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "snipnote",
  "version": "0.1.0",
  "identifier": "com.achuth.snipnote",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "snipnote",
        "width": 1280,
        "height": 720,
        "minWidth": 1100,
        "minHeight": 600,
        "transparent": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown file",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "deepLink": {
      "schemes": ["snipnote"]
    },
    "singleInstance": {
      "enabled": true
    }
  }
}
