{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sote",
  "version": "0.1.1",
  "identifier": "com.achuth.sote",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Local-first Markdown notes",
    "longDescription": "sote is a fast local Markdown editor for macOS and Windows. Open any folder, edit .md files in a WYSIWYG editor, and keep disk as the source of truth.",
    "copyright": "Copyright © 2026 Achuth. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown file",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "dmg": {
        "background": "icons/dmg-background.png",
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  },
  "plugins": {
    "deepLink": {
      "schemes": ["sote"]
    },
    "singleInstance": {
      "enabled": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBQzAwOEIzMkVBODcxNDkKUldSSmNhZ3Vzd2pBT2paMUxpTVpMQTRHVjdSaVVHMEdEaitBbE5DSU9VUUFheDRCakt1VmJLaGMK",
      "endpoints": [
        "https://github.com/achuthhadnoor/sote/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive",
        "installerArgs": []
      }
    }
  }
}
